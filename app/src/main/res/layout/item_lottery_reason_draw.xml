<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardBackgroundColor="@color/sand_50"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/surface_outline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/textPeriod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/slate_950"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="第 115000019 期  2026/03/05" />

        <TextView
            android:id="@+id/textNumbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/sage_800"
            android:textSize="14sp"
            tools:text="開獎號碼 07 11 14 32 36 38    特別號 02" />

        <TextView
            android:id="@+id/textMatches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/slate_700"
            android:textSize="13sp"
            tools:text="第一組: 主號中 5, 特別號中  命中號碼 07 11 23 32 38" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
